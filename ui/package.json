{
  "name": "watchtower-ui",
  "productName": "Watchtower",
  "version": "0.2.0",
  "description": "Watchtower desktop app: shows alerts and controls from the Watchtower Windows service.",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --win dir",
    "test:e2e": "node test/e2e.js && node test/e2e.js --standard-user"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.55.0"
  },
  "build": {
    "appId": "com.watchtower.app",
    "productName": "Watchtower",
    "directories": {
      "output": "../artifacts/ui"
    },
    "win": {
      "target": "dir",
      "icon": "renderer/tray-icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*"
    ]
  }
}
